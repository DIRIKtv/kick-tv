<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="24dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_wordmark" />

        <TextView android:id="@+id/navHome" style="@style/NavItem" android:drawableStart="@drawable/ic_home" android:text="Home" />
        <TextView android:id="@+id/navFollowing" style="@style/NavItem" android:drawableStart="@drawable/ic_heart" android:text="Following" />
        <TextView android:id="@+id/navBrowse" style="@style/NavItem" android:drawableStart="@drawable/ic_grid" android:text="Browse" />
        <TextView android:id="@+id/navSearch" style="@style/NavItem" android:drawableStart="@drawable/ic_search" android:text="Search" />
        <TextView android:id="@+id/navSettings" style="@style/NavItem" android:drawableStart="@drawable/ic_tune" android:text="Settings" />
    </LinearLayout>

    <com.diriktv.sidekick.ui.ContentFrame
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
