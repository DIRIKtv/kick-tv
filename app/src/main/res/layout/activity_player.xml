<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            app:resize_mode="fit"
            app:show_buffering="never"
            app:shutter_background_color="@android:color/black"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <com.kicktv.app.ui.TraceLoader
            android:id="@+id/buffering"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Seek / action feedback shown while controls are hidden -->
        <TextView
            android:id="@+id/osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_osd"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="26dp"
            android:paddingBottom="14dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="24dp"
            android:layout_marginTop="110dp"
            android:background="@drawable/bg_chip_dark"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Error -->
        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_osd"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="28dp"
            android:paddingEnd="40dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center"
                android:maxWidth="520dp"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/retryButton"
                style="@style/Pill"
                android:layout_marginEnd="0dp"
                android:drawableStart="@drawable/ic_refresh"
                android:text="Retry" />
        </LinearLayout>

        <!-- Controls overlay -->
        <FrameLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/scrim_top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="40dp"
                android:paddingTop="28dp"
                android:paddingEnd="40dp"
                android:paddingBottom="56dp">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/streamTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/channelName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/kick_green"
                            android:textSize="14sp" />

                        <!-- Live viewer count; its digits roll when a refresh changes it. -->
                        <com.kicktv.app.ui.RollingCounter
                            android:id="@+id/viewerCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/streamMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/scrim_bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingTop="80dp"
                android:paddingEnd="40dp"
                android:paddingBottom="22dp">

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginStart="-12dp"
                    android:layout_marginEnd="-12dp"
                    android:background="@null"
                    android:focusable="true"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:progressDrawable="@drawable/seek_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/durationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="6dp"
                    android:clipChildren="false">

                    <!-- Left: live status / jump to live -->
                    <TextView
                        android:id="@+id/btnLive"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_live_pill"
                        android:focusable="true"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp"
                        android:textColor="@color/on_focus_primary"
                        android:textSize="14sp" />

                    <!-- Center: transport -->
                    <LinearLayout
                        android:id="@+id/transport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton android:id="@+id/btnRewind" style="@style/CtrlButton" android:contentDescription="Rewind" android:src="@drawable/ic_replay" />
                        <ImageButton android:id="@+id/btnPlay" style="@style/CtrlButton" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:padding="16dp" android:contentDescription="Play/Pause" android:src="@drawable/ic_pause" />
                        <ImageButton android:id="@+id/btnForward" style="@style/CtrlButton" android:contentDescription="Forward" android:src="@drawable/ic_forward" />
                    </LinearLayout>

                    <!-- Right: secondary actions -->
                    <LinearLayout
                        android:id="@+id/actions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <ImageButton android:id="@+id/btnCaptions" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Captions" android:src="@drawable/ic_cc" android:visibility="gone" />
                        <ImageButton android:id="@+id/btnChat" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Chat" android:src="@drawable/ic_chat" />
                        <ImageButton android:id="@+id/btnFollow" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Follow" android:src="@drawable/ic_heart_outline" />
                        <ImageButton android:id="@+id/btnSettings" style="@style/CtrlButton" android:layout_marginStart="10dp" android:contentDescription="Settings" android:src="@drawable/ic_settings" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Label that floats above the focused button -->
            <TextView
                android:id="@+id/tooltip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tooltip"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="#000000"
                android:textSize="12sp"
                android:visibility="invisible" />
        </FrameLayout>
    </FrameLayout>

    <!-- Chat -->
    <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/chat_bg"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chatHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:text="STREAM CHAT"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:descendantFocusability="blocksDescendants"
            android:focusable="false"
            android:overScrollMode="never"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false" />
    </LinearLayout>

</FrameLayout>
