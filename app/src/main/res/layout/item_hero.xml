<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="28dp"
    android:paddingTop="6dp"
    android:paddingEnd="28dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:background="@drawable/bg_hero"
        android:focusable="true"
        android:foreground="@drawable/fg_hero">

        <ImageView
            android:id="@+id/heroImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="150dp"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_hero" />

        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_hero_bottom" />

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/heroEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_eyebrow"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/heroAvatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/heroName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:textColor="@color/kick_green"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/heroHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="6dp"
                android:drawableTint="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <com.diriktv.sidekick.ui.StepPlayerView
            android:id="@+id/heroSteps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/heroPrev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="2dp"
            android:alpha="0.8"
            android:rotation="180"
            android:src="@drawable/ic_chevron" />

        <ImageView
            android:id="@+id/heroNext"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="2dp"
            android:alpha="0.8"
            android:src="@drawable/ic_chevron" />
    </FrameLayout>
</FrameLayout>
